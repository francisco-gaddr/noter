{
  "name": "noter-app",
  "private": true,
  "scripts": {
    "build": "npm run bump-build && turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "bump-build": "node scripts/bump-build.js"
  },
  "devDependencies": {
    "@expo/config-plugins": "^54.0.4",
    "jest-expo": "^54.0.16",
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-get-random-values": "1.11.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "react-native-svg": "15.12.1",
    "react-native-safe-area-context": "5.6.0",
    "react-native": "0.81.5"
  },
  "packageManager": "npm@11.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
