{
  "name": "electron-noter",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "dev": "node src/dev.js",
    "start": "node src/start.js",
    "build:web": "node src/build-web.js",
    "build": "npm run build:web && electron-builder",
    "test": "jest",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.noter.electron",
    "productName": "Noter",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "publish": {
      "provider": "generic",
      "url": "https://updates.noter.app/releases/${os}/${arch}",
      "channel": "stable"
    },
    "fileAssociations": [
      {
        "ext": "noter",
        "name": "Noter Document",
        "description": "Noter note file",
        "role": "Editor"
      },
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown note",
        "role": "Editor"
      }
    ],
    "protocols": [
      {
        "name": "Noter Protocol",
        "schemes": ["noter"]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "jest": "^30.2.0"
  }
}
