{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "eslint": false,
  "jest": false,
  "next": false,
  "ignoreWorkspaces": [
    "packages/typescript-config",
    "packages/eslint-config"
  ],
  "ignore": [
    "scripts/**"
  ],
  "workspaces": {
    "apps/mobile": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "index.{ts,tsx,js}",
        "App.{ts,tsx}",
        "babel.config.js",
        "metro.config.js",
        "app.config.{js,ts}",
        "**/*.{web,ios,android,native}.{ts,tsx}",
        "**/*.test.{ts,tsx}",
        "__tests__/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ],
      "ignore": [
        ".expo/**",
        "android/**",
        "ios/**"
      ],
      "ignoreDependencies": [
        "jest-expo",
        "react-native-bundle-visualizer"
      ]
    },
    "apps/web": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "next.config.{js,mjs,ts}",
        "**/*.test.{ts,tsx}"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ],
      "ignore": [
        "node_modules/**",
        ".next/**"
      ]
    },
    "apps/backend": {
      "entry": [
        "**/*.test.ts",
        "__tests__/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignore": [
        "node_modules/**",
        "dist/**"
      ]
    },
    "packages/*": {
      "entry": [
        "**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignore": [
        "node_modules/**",
        "dist/**"
      ]
    }
  },
  "ignoreDependencies": [
    "@repo/typescript-config",
    "@repo/eslint-config",
    "ts-jest",
    "jest-expo",
    "expo-router",
    "@expo/config-plugins",
    "jest-environment-jsdom"
  ]
}
