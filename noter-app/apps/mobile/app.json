{
  "expo": {
    "name": "Noter",
    "slug": "noter",
    "version": "1.7.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "noter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noter.app",
      "buildNumber": "15",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Noter uses FaceID to unlock your secure notes.",
        "NSPhotoLibraryUsageDescription": "Noter behöver åtkomst till dina bilder för att bifoga dem till anteckningar.",
        "NSCameraUsageDescription": "Noter behöver åtkomst till kameran för att ta bilder till anteckningar.",
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0C0C10"
      },
      "package": "com.noter.app",
      "versionCode": 16,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-local-authentication",
      "expo-notifications",
      "expo-background-fetch",
      "expo-task-manager",
      "./plugins/withCustomEntryPoint",
      "./plugins/withCustomBuildGradle",
      "llama.rn",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.0",
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0C0C10",
          "dark": {
            "backgroundColor": "#050507"
          }
        }
      ],
      "expo-font",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "78d433b3-18a7-4537-a4dd-2ab8a070e09c"
      }
    }
  }
}
