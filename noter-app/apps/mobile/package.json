{
  "name": "mobile",
  "main": "index.js",
  "version": "1.0.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build -p android --profile preview",
    "build:apk": "eas build -p android --profile apk",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "test:android:mlc-device-e2e": "cd android && gradlew connectedAndroidTest -Pandroid.testInstrumentationRunnerArguments.class=com.noter.app.MLCConverterDeviceE2ETest",
    "postinstall": "turbo run build --filter=@repo/shared --filter=@repo/ai"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fs",
          "react-native-zip-archive"
        ]
      }
    }
  },
