{
  "manifest_version": 2,
  "name": "Noter Sidebar",
  "version": "0.1.0",
  "description": "Minimal Firefox-extension for Noter with sidebar, quick navigation and queued captures.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "sidebar_action": {
    "default_title": "Noter",
    "default_panel": "sidebar.html"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Noter sidebar"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "noter-sidebar@example.local"
    }
  }
}
